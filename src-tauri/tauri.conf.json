{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ma Tête",
  "version": "0.1.0",
  "identifier": "com.matete.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ma Tête",
        "url": "index.html",
        "width": 320,
        "height": 200,
        "visible": false,
        "resizable": false
      },
      {
        "label": "panel",
        "title": "Ma Tête — Panneau",
        "url": "panel.html",
        "width": 400,
        "height": 720,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "shadow": false
      },
      {
        "label": "capture",
        "title": "Ma Tête — Capture",
        "url": "capture.html",
        "width": 440,
        "height": 268,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "center": true
      },
      {
        "label": "library",
        "title": "MIND — Bibliothèque",
        "url": "library.html",
        "width": 920,
        "height": 700,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
